{
  "name": "anatomy3d",
  "version": "0.14.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --port 3016",
    "build": "vite build",
    "check": "tsc --noEmit",
    "validate": "node scripts/validate-atlas.mjs && node scripts/validate-interactions.mjs && node scripts/validate-names.mjs && node scripts/validate-regions.mjs && node scripts/validate-layers.mjs && node scripts/validate-cards.mjs && node scripts/validate-attachments.mjs && node scripts/validate-quiz.mjs && node scripts/validate-knee.mjs && node scripts/validate-female.mjs",
    "atlas": "node scripts/build-atlas.mjs",
    "knee": "node scripts/build-knee.mjs",
    "female": "node scripts/build-female.mjs",
    "layers": "node scripts/compute-muscle-layers.mjs",
    "members": "node scripts/compute-region-members.mjs && node scripts/compute-area-members.mjs",
    "review": "node scripts/review-sheets.mjs",
    "cards": "node scripts/muscle-cards.mjs",
    "attachments": "node scripts/attachment-report.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@types/three": "^0.186.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "meshoptimizer": "^1.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "three-mesh-bvh": "^0.9.16",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  },
  "type": "module",
  "license": "MIT"
}
